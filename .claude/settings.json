{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python main.py stats)",
      "Bash(python main.py reparse)",
      "Bash(python -m tokopedia_scraper.parsers)",
      "Bash(python -m tokopedia_scraper.storage)",
      "Bash(python scripts/eval_listing.py:*)",
      "Bash(python scripts/pricing_demo_offline.py:*)",
      "Bash(python scripts/verify_capture.py --offline:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./config/gql_capture.yaml)",
      "Read(./capture_*.txt)"
    ]
  }
}
