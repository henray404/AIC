# Secrets — NEVER commit
.env
config/gql_capture.yaml

# DevTools captures: these hold the raw Cookie header verbatim. They are meant
# to be deleted as soon as scripts/curl_to_config.py has read them, but a
# forgotten one must never reach a commit.
capture_*.txt

# Scraped data, images, exports, database
data/
logs/

# Salinan lokal dataset Drive (0,9 GB: gambar, merged, ekspor tiap sumber).
# Bisa diunduh ulang kapan saja lewat scripts/fetch_drive_iac.py — lihat docs/DATASET.md.
data_drive/

# Sisa unduhan yang putus di tengah jalan
*.part

# Browser profile (contains session cookies)
*.profile/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Notebooks
.ipynb_checkpoints/

# Paket kirim ke server sewaan (hasil generasi, bisa dibuat ulang)
hasil_sesi1/

# Bobot adapter dan tokenizer: 184 MB, hasil latihan bukan sumber. README,
# adapter_config.json, dan chat_template tetap masuk git supaya struktur dan
# hiperparameternya terlacak.
model_sulingan/*/adapter_model.safetensors
model_sulingan/*/tokenizer.json

# Keluaran eksperimen sesi 2 (219 MB). Sama seperti hasil_sesi1.
hasil_sesi2/

# Paket gambar untuk dikirim ke server sewaan (1,9 GB, bisa dibuat ulang
# dari data/images). Sempat ikut ter-commit karena `git add` terlalu luas.
tokopedia_gambar1.tar
*.tar

# Salinan adapter di akar repo, sisa scp lama. Yang dipakai ada di
# model_sulingan/ dan bobotnya sudah diabaikan di sana.
/murid_lora/
/murid_vlm_lora/
/guru.jsonl
model_sulingan.zip

# Berkas penilaian manusia: HTML memuat foto produk base64 (2,8 MB), dan
# hasil.json memuat penilaian yang belum dianalisis. Keduanya hasil kerja,
# bisa dibuat ulang dengan scripts/buat_penilaian.py.
penilaian/*.html
penilaian/hasil*.json
