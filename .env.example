# Copy to .env and fill in. .env is gitignored — never commit real values.
# cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# ---------------------------------------------------------------------------
# Tokopedia session — capture from Chrome DevTools.
# See docs/CAPTURE_HEADERS.md. scripts/curl_to_config.py writes these for you.
# ---------------------------------------------------------------------------

# Full Cookie header, verbatim from the captured request. Expires — recapture
# when GraphQLFetcher starts returning 403.
TOKOPEDIA_COOKIE=

# User-Agent of the browser you captured from. Must match the cookie's browser,
# otherwise Tokopedia's bot detection sees a mismatch.
TOKOPEDIA_UA=

# Extra headers Tokopedia requires. Names/values vary by endpoint — whatever
# curl_to_config.py flags as sensitive lands here. Leave blank if unused.
TOKOPEDIA_X_TKPD_AKAMAI=
TOKOPEDIA_AUTHORIZATION=

# ---------------------------------------------------------------------------
# ManagedFetcher credentials (paid backends). Only fill the provider you use.
# Missing key -> clear error message, not a traceback.
# ---------------------------------------------------------------------------
SCRAPINGBEE_API_KEY=
ZENROWS_API_KEY=
APIFY_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Proxy for every backend. Leave blank to go direct.
# PROXY_URL=http://user:pass@host:port

# Override any config.yaml value: TOKOSCRAPE_<SECTION>__<KEY> (double
# underscore = nesting). Top-level keys need no section.
# TOKOSCRAPE_FETCHER=graphql
# TOKOSCRAPE_RATE_LIMIT__MIN_DELAY=3.0
